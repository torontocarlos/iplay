# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Gmail OAuth2 (from Google Cloud Console)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:3000/oauth/callback

# Microsoft/Outlook OAuth2 (from Azure AD App Registration)
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_TENANT_ID=common
OUTLOOK_REDIRECT_URI=http://localhost:3000/oauth/callback

# Triage settings
AUTO_REPLY=false
BATCH_SIZE=50
POLL_INTERVAL_MS=300000
